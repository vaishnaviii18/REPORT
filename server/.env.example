# Contributor setup: copy this file to .env and replace the MongoDB, JWT, and
# Cloudinary placeholders with your own values. Never commit real credentials.
# Get MONGODB_URI from MongoDB Atlas (Connect > Drivers), or use:
# MONGODB_URI=mongodb://127.0.0.1:27017/the-report
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<your-cluster>.mongodb.net/report?retryWrites=true&w=majority&appName=report
JWT_SECRET=change-me-to-a-long-random-string
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
CRON_SECRET=change-me-too
CLIENT_URL=http://localhost:5173
APP_TIMEZONE=Asia/Kolkata
PORT=4000
